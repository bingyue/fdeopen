{
  "name": "fdeopen",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3210",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node --env-file-if-exists=.env.local scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
    "github:refresh": "node --env-file-if-exists=.env.local --import tsx scripts/refresh-sources.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "admin:grant": "node --env-file-if-exists=.env.local --import tsx scripts/grant-admin.ts",
    "admin:bootstrap": "node --env-file-if-exists=.env.local --import tsx scripts/bootstrap-account.ts",
    "account:reset-password": "node --env-file-if-exists=.env.local --import tsx scripts/reset-account-password.ts",
    "release:check": "node --env-file-if-exists=.env.local --import tsx scripts/check-production.ts",
    "format": "prettier --write src scripts tests *.ts *.mjs content/*.json docs/*.md README.md",
    "test:postgres": "node --import tsx tests/postgres-integration.ts",
    "audit:site": "node scripts/audit-site.mjs",
    "content:prepare": "python3 scripts/prepare-media-library.py",
    "content:clean-sources": "node --env-file-if-exists=.env.local --import tsx scripts/clean-media-sources.ts",
    "content:import": "node --env-file-if-exists=.env.local --import tsx scripts/import-media-library.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@radix-ui/react-slot": "^1.4.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "next": "^16.4.0",
    "next-mdx-remote": "^6.0.0",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
