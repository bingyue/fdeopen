# Local: npm run dev. Persisted local PostgreSQL-compatible database in .data/
APP_MODE=demo
NEXT_PUBLIC_SITE_URL=http://localhost:3210
DEMO_DATA_DIR=.data/fdeopen
# For a deliberately shared demo only; never reuse real credentials/data.
ALLOW_DEMO_IN_PRODUCTION=false
DEMO_ACCESS_KEY=
# Docker / self-hosted: APP_MODE=postgres, DATABASE_URL required; built-in account login.
# Optional hosted mode: APP_MODE=supabase, all three fields below required.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# GitHub token is optional for public repositories, increases API quota.
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
CRON_SECRET=

# Optional: actual learning platform URL; empty links to local ecosystem explanation.
FDE_LEARNING_URL=

# Persist uploads with the database; absolute path recommended in production.
MEDIA_UPLOAD_DIR=.data/uploads
