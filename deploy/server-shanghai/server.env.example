# Copy to server.env on the server, chmod 600. Never commit the real file.
FDEOPEN_IMAGE=fdeopen:release
FDEOPEN_TOOLS_IMAGE=fdeopen-tools:release
# Tencent's Docker Hub mirror can be used when Docker Hub is unreachable.
NODE_IMAGE=mirror.ccs.tencentyun.com/library/node:22-bookworm-slim
POSTGRES_IMAGE=mirror.ccs.tencentyun.com/library/postgres:17-alpine
NEXT_PUBLIC_SITE_URL=https://fdeopen.com
FDE_LEARNING_URL=https://51fde.net
# Use openssl rand -hex 32. Hex avoids URL/Compose escaping ambiguities.
POSTGRES_PASSWORD=
APP_DATABASE_PASSWORD=
# Optional public repository sync credentials; never NEXT_PUBLIC_*.
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
CRON_SECRET=
